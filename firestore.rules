// firebase-security-rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own user doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Patients: staff & patient owners
    match /patients/{patientId} {
      allow read: if isStaffForClinic() || resource.data.userId == request.auth.uid;
      allow write: if isStaffForClinic();
    }

    // Appointments: patient owns or staff for clinic
    match /appointments/{appointmentId} {
      allow read, write: if isStaffForClinic() || resource.data.patientId == getUserId();
    }

    // Helper
    function getUserId() { return request.auth.uid; }
    function isStaffForClinic() {
      return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
  }
}